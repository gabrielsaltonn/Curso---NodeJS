<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Postagens Node.Js</title>
    <style>
        .pagina-lista {
            max-width: 900px;
            margin: 40px auto;
            font-family: Arial, sans-serif;
        }

        .pagina-lista h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        .tabela-impressoras {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .tabela-impressoras th,
        .tabela-impressoras td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }

        .tabela-impressoras th {
            background-color: #f4f4f4;
        }

        .col-acao {
            width: 60px;
        }

        .formDel {
            margin: 0;
        }

        .btn-del {
            width: 28px;
            height: 28px;
            padding: 0;
            border: none;
            background-color: #e74c3c;
            color: white;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-del:hover {
            background-color: #c0392b;
        }

        .pagina-cadastro {
            display: flex;
            justify-content: center;
            margin-top: 60px;
            font-family: Arial, sans-serif;
        }

        .form-cadastro {
            width: 400px;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            background-color: white;
            display: flex;
            flex-direction: column;
        }

        .form-cadastro h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .form-cadastro label {
            margin-top: 10px;
            font-size: 14px;
        }

        .form-cadastro input {
            padding: 8px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .btn-cadastrar {
            margin-top: 20px;
            padding: 10px;
            border: none;
            background-color: #3498db;
            color: white;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-cadastrar:hover {
            background-color: #2980b9;
        }
    </style>
</head>
<body>
    {{{body}}}
</body>
</html>